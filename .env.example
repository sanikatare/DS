# UPI Distributed Transaction Simulator - Environment Configuration Example

# Central Hub Microservice URLs
SENDER_BANK_URL=http://localhost:8001
NPCI_URL=http://localhost:8002
RECEIVER_BANK_URL=http://localhost:8003
RECEIVER_BANK_PEER_URL=http://localhost:8003

# gRPC Microservice Addresses
SENDER_BANK_GRPC_URL=localhost:50051
NPCI_GRPC_URL=localhost:50052
RECEIVER_BANK_GRPC_URL=localhost:50053

# Message Broker Configuration (RabbitMQ AMQP)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Fault Tolerance & Retry Parameters
REQUEST_TIMEOUT_SECONDS=3.0
MAX_RETRIES=2
RETRY_DELAY_SECONDS=1.0

# 3-State Circuit Breaker Thresholds
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=10.0
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=1
