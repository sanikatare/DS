# Copy to .env and adjust if the transaction-service isn't on localhost:8000.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.

# Base URL of the transaction-service REST API
VITE_TXN_API_URL=http://localhost:8000

# WebSocket URL for live transaction events.
# Leave unset to auto-derive from VITE_TXN_API_URL (http->ws, https->wss).
# VITE_TXN_WS_URL=ws://localhost:8000/ws/transactions
